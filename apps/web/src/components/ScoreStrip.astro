---
import type { GameSummary } from "@huddle/shared";
import { teamConfig } from "@huddle/shared";

import { formatKickoff, resultWord } from "../lib/week";
import TierBadge from "./TierBadge.astro";

interface Props {
  game: GameSummary;
}

const { game } = Astro.props;
const team = teamConfig.team;
const spread =
  game.line.spread === null
    ? null
    : game.line.spread < 0
      ? `${team} ${game.line.spread}`
      : `${team} +${game.line.spread}`;
const chips = [game.venue.stadium, game.venue.roof, game.venue.surface];
if (game.venue.temp !== null) chips.push(`${Math.round(game.venue.temp)}°F`);
if (game.venue.wind !== null) chips.push(`wind ${Math.round(game.venue.wind)} mph`);
if (spread !== null) chips.push(`line ${spread}`);
if (game.line.total !== null) chips.push(`total ${game.line.total}`);

const sides = [game.away, game.home] as const;
const won = game.team.result === "W";
---

<section aria-labelledby="score-heading" class="panel overflow-hidden">
  <h2 id="score-heading" class="sr-only">
    Final score
  </h2>
  <div class="grid grid-cols-[1fr_auto_1fr] items-center gap-2 px-4 pt-5 pb-4 sm:gap-6 sm:px-8">
    {sides.map((side, i) => {
      const isTeam = side.team === team;
      return (
        <div class:list={["flex flex-col", i === 0 ? "items-end text-right" : "items-start"]}>
          <span
            class:list={[
              "font-display text-lg font-semibold tracking-wider uppercase",
              isTeam ? "text-honolulu-bright" : "text-silver",
            ]}
          >
            {side.team}
            {isTeam && <span class="sr-only"> ({teamConfig.teamName})</span>}
          </span>
          <span
            class:list={[
              "display text-7xl tabular-nums sm:text-8xl",
              isTeam ? "text-white" : "text-silver/80",
            ]}
          >
            {side.score}
          </span>
        </div>
      );
    })}
    <div class="col-start-2 row-start-1 flex flex-col items-center gap-2">
      <span class="eyebrow">at</span>
      <span
        class:list={[
          "display rounded-md px-3 py-1 text-lg",
          won ? "bg-honolulu text-white" : "bg-silver text-ink",
        ]}
      >
        {resultWord(game.team.result)}
        {game.overtime && " · OT"}
      </span>
      <TierBadge tier={game.tier} />
    </div>
  </div>
  <ul
    class="flex flex-wrap items-center gap-x-3 gap-y-1 border-t border-white/10 bg-black/20 px-4 py-2 text-sm text-silver sm:px-8"
    aria-label="Game details"
  >
    <li>
      <time datetime={game.kickoffUtc}>{formatKickoff(game.kickoffUtc)}</time>
    </li>
    {chips.map((c) => (
      <li class="before:mr-3 before:text-white/30 before:content-['·']">{c}</li>
    ))}
  </ul>
</section>
