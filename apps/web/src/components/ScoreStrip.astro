---
import type { GameSummary } from "@huddle/shared";
import { teamConfig } from "@huddle/shared";

import { formatKickoff, resultWord } from "../lib/week";
import TierBadge from "./TierBadge.astro";

interface Props {
  game: GameSummary;
}

const { game } = Astro.props;
const team = teamConfig.team;
const spread =
  game.line.spread === null
    ? null
    : game.line.spread < 0
      ? `${team} ${game.line.spread}`
      : `${team} +${game.line.spread}`;
const venueBits = [game.venue.stadium, game.venue.roof, game.venue.surface];
if (game.venue.temp !== null) venueBits.push(`${Math.round(game.venue.temp)}°F`);
if (game.venue.wind !== null) venueBits.push(`wind ${Math.round(game.venue.wind)} mph`);
---

<section aria-labelledby="score-heading" class="rounded-lg border border-silver/50 p-4">
  <h2 id="score-heading" class="sr-only">
    Final score
  </h2>
  <div class="flex flex-wrap items-center justify-between gap-4">
    <dl class="flex items-center gap-6 text-2xl font-extrabold tabular-nums sm:text-3xl">
      <div class="flex items-baseline gap-2">
        <dt class:list={["text-base font-semibold", game.away.team === team && "text-honolulu"]}>
          {game.away.team}
        </dt>
        <dd>{game.away.score}</dd>
      </div>
      <span aria-hidden="true" class="text-base font-medium text-ink/70 dark:text-silver/70">
        at
      </span>
      <div class="flex items-baseline gap-2">
        <dt class:list={["text-base font-semibold", game.home.team === team && "text-honolulu"]}>
          {game.home.team}
        </dt>
        <dd>{game.home.score}</dd>
      </div>
    </dl>
    <p class="flex items-center gap-2 text-sm font-semibold">
      <span
        class:list={[
          "rounded px-2 py-0.5 text-white",
          game.team.result === "W" ? "bg-honolulu" : "bg-ink dark:bg-silver dark:text-ink",
        ]}
      >
        {resultWord(game.team.result)}
        {game.overtime && " (OT)"}
      </span>
      <TierBadge tier={game.tier} />
    </p>
  </div>
  <p class="mt-3 text-sm text-ink/80 dark:text-silver/80">
    <time datetime={game.kickoffUtc}>{formatKickoff(game.kickoffUtc)}</time>
    {" · "}
    {venueBits.join(" · ")}
    {spread !== null && ` · line ${spread}`}
    {game.line.total !== null && ` · total ${game.line.total}`}
  </p>
</section>
