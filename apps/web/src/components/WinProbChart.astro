---
/**
 * Win-probability chart rendered at build time: d3-scale and d3-shape run in Node, the browser
 * receives one <path>. No client JavaScript.
 */
import type { WinProbability } from "@huddle/shared";
import { scaleLinear } from "d3-scale";
import { line } from "d3-shape";

import { formatPct } from "../lib/format";

interface Props {
  data: WinProbability;
  team: string;
  opponent: string;
}

const { data, team, opponent } = Astro.props;
type Point = WinProbability["points"][number];

const W = 720;
const H = 260;
const M = { top: 16, right: 16, bottom: 32, left: 44 };
const REG = 3600;
const OT = 600;
const hasOt = data.points.some((p) => p.qtr > 4);
const total = hasOt ? REG + OT : REG;

/** Seconds elapsed since kickoff; overtime periods count on from regulation. */
const elapsed = (p: Point): number =>
  p.qtr <= 4 ? REG - p.secondsRemaining : REG + (OT - Math.min(p.secondsRemaining, OT));

const x = scaleLinear()
  .domain([0, total])
  .range([M.left, W - M.right]);
const y = scaleLinear()
  .domain([0, 1])
  .range([H - M.bottom, M.top]);

const points = [...data.points].sort((a, b) => elapsed(a) - elapsed(b));
const path =
  line<Point>()
    .x((p) => x(elapsed(p)))
    .y((p) => y(p.teamWp))(points) ?? "";

const quarters = [0, 900, 1800, 2700, 3600].concat(hasOt ? [total] : []);
const quarterLabels = ["Q1", "Q2", "Q3", "Q4"].concat(hasOt ? ["OT"] : []);

const first = points[0];
const last = points[points.length - 1];
let desc = "No win-probability data.";
if (first && last) {
  const lowest = points.reduce((a, p) => (p.teamWp < a.teamWp ? p : a), first);
  const highest = points.reduce((a, p) => (p.teamWp > a.teamWp ? p : a), first);
  desc = `${team} win probability started at ${formatPct(first.teamWp, 0)}, dipped to ${formatPct(lowest.teamWp, 0)} in the ${ordinalQ(lowest.qtr)} quarter, peaked at ${formatPct(highest.teamWp, 0)} and finished at ${formatPct(last.teamWp, 0)}.`;
}

function ordinalQ(q: number): string {
  return ["first", "second", "third", "fourth", "overtime", "second overtime"][q - 1] ?? `${q}th`;
}

function clock(p: Point): string {
  const inPeriod = p.qtr <= 4 ? p.secondsRemaining - (4 - p.qtr) * 900 : p.secondsRemaining;
  const s = Math.max(0, inPeriod);
  return `${Math.floor(s / 60)}:${String(s % 60).padStart(2, "0")}`;
}

// Screen-reader table: every 5th play plus the last one keeps the DOM small.
const sampled = points.filter((_, i) => i % 5 === 0 || i === points.length - 1);
---

<figure class="mt-4">
  <svg
    viewBox={`0 0 ${W} ${H}`}
    class="h-auto w-full"
    role="img"
    aria-labelledby="wp-title wp-desc"
  >
    <title id="wp-title">{team} win probability against {opponent}, play by play</title>
    <desc id="wp-desc">{desc}</desc>
    <g aria-hidden="true">
      {quarters.map((sec, i) => (
        <g>
          <line
            x1={x(sec)}
            x2={x(sec)}
            y1={M.top}
            y2={H - M.bottom}
            class="stroke-silver"
            stroke-width="1"
          />
          {i < quarterLabels.length && (
            <text
              x={(x(sec) + x(quarters[i + 1] ?? total)) / 2}
              y={H - 10}
              text-anchor="middle"
              class="fill-current text-[12px]"
            >
              {quarterLabels[i]}
            </text>
          )}
        </g>
      ))}
      {[0, 0.5, 1].map((v) => (
        <g>
          <line
            x1={M.left}
            x2={W - M.right}
            y1={y(v)}
            y2={y(v)}
            class="stroke-silver"
            stroke-width={v === 0.5 ? 1.5 : 1}
            stroke-dasharray={v === 0.5 ? "4 4" : undefined}
          />
          <text x={M.left - 6} y={y(v) + 4} text-anchor="end" class="fill-current text-[12px]">
            {Math.round(v * 100)}%
          </text>
        </g>
      ))}
      <path
        d={path}
        fill="none"
        class="stroke-honolulu"
        stroke-width="2.5"
        stroke-linejoin="round"
      />
    </g>
  </svg>
  <figcaption class="mt-1 text-sm text-ink/80 dark:text-silver/80">
    {team} win probability (nflverse model) over game time.
  </figcaption>
  <div class="sr-only">
    <table>
      <caption>{`${team} win probability by play (sampled every fifth play)`}</caption>
      <thead>
        <tr>
          <th scope="col">Quarter</th>
          <th scope="col">Clock</th>
          <th scope="col">{team} win probability</th>
          <th scope="col">Score</th>
        </tr>
      </thead>
      <tbody>
        {sampled.map((p) => (
          <tr>
            <td>{p.qtr <= 4 ? `Q${p.qtr}` : "OT"}</td>
            <td>{clock(p)}</td>
            <td>{formatPct(p.teamWp, 0)}</td>
            <td>
              {team} {p.teamScore}, {opponent} {p.oppScore}
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</figure>
