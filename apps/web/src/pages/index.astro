---
import { teamConfig } from "@huddle/shared";
import { getEntry } from "astro:content";

import TierBadge from "../components/TierBadge.astro";
import Base from "../layouts/Base.astro";
import { byWeekDesc, formatKickoff, gameHref, resultWord, weekId } from "../lib/week";

const siteName = import.meta.env.PUBLIC_SITE_NAME ?? teamConfig.siteName;
const manifest = await getEntry("manifest", "manifest");
const latest = [...(manifest?.data.weeks ?? [])].sort(byWeekDesc)[0];
const game = latest ? await getEntry("games", weekId(latest.season, latest.week)) : undefined;
const teamScore = game
  ? game.data.team.side === "home"
    ? game.data.home.score
    : game.data.away.score
  : null;
const oppScore = game
  ? game.data.team.side === "home"
    ? game.data.away.score
    : game.data.home.score
  : null;
const venue = game ? (game.data.team.side === "home" ? "vs" : "at") : "";

const features = [
  {
    title: "Field heat map",
    body: "Twenty-seven spots on a drawn field, coloured by how each position group played. Click any tile to see who was there and why they graded that way.",
  },
  {
    title: "Huddle Grade",
    body: "Every player ranked against the whole league at his position that week, blended with published weights. Nothing hidden, nothing proprietary.",
  },
  {
    title: "Open data, open code",
    body: "Built on nflverse play-by-play and advanced stats. Every number on the site can be traced to its source, and the repository is public.",
  },
];
---

<Base title={siteName}>
  <section class="pt-10 pb-12 sm:pt-16">
    <p class="eyebrow">
      {teamConfig.division} · {teamConfig.teamName}
    </p>
    <h1 class="display mt-3 text-6xl text-white sm:text-8xl">{siteName}</h1>
    <p class="mt-5 max-w-2xl text-lg text-silver sm:text-xl">{teamConfig.tagline}</p>
  </section>

  {latest && game && teamScore !== null && oppScore !== null && (
    <section aria-labelledby="latest-heading" class="panel overflow-hidden">
      <div class="flex flex-wrap items-center justify-between gap-3 px-5 pt-4">
        <h2 id="latest-heading" class="eyebrow">
          Latest game · {latest.season} week {latest.week}
        </h2>
        <TierBadge tier={latest.tier} />
      </div>
      <div class="flex flex-wrap items-end justify-between gap-6 px-5 pt-3 pb-5">
        <div>
          <p class="display text-5xl text-white sm:text-7xl">
            <span class={latest.result === "W" ? "text-honolulu-bright" : "text-silver"}>
              {resultWord(latest.result)}
            </span>
            {` ${venue} ${latest.opponent}`}
          </p>
          <p class="display mt-1 text-4xl tabular-nums text-silver sm:text-5xl">
            <span class="text-white">{teamScore}</span>
            <span class="text-white/40"> – </span>
            {oppScore}
          </p>
          <p class="mt-2 text-sm text-silver/80">
            <time datetime={game.data.kickoffUtc}>{formatKickoff(game.data.kickoffUtc)}</time>
            {" · "}
            {game.data.venue.stadium}
          </p>
        </div>
        <a
          href={gameHref(latest.season, latest.week)}
          class="display inline-flex items-center gap-2 rounded-md bg-honolulu px-5 py-3 text-xl text-white no-underline shadow-lg shadow-honolulu/30 hover:bg-honolulu-bright"
        >
          Open the breakdown
          <span aria-hidden="true">→</span>
        </a>
      </div>
    </section>
  )}

  <section aria-label="What is here" class="mt-10 grid gap-4 sm:grid-cols-3">
    {features.map((f) => (
      <article class="panel p-5">
        <h2 class="display text-2xl text-white">{f.title}</h2>
        <p class="mt-2 text-sm leading-relaxed text-silver">{f.body}</p>
      </article>
    ))}
  </section>
</Base>
