---
import { teamConfig } from "@huddle/shared";
import { getEntry } from "astro:content";

import TierBadge from "../components/TierBadge.astro";
import Base from "../layouts/Base.astro";
import { byWeekDesc, gameHref, resultWord, weekId } from "../lib/week";

const siteName = import.meta.env.PUBLIC_SITE_NAME ?? teamConfig.siteName;
const manifest = await getEntry("manifest", "manifest");
const latest = [...(manifest?.data.weeks ?? [])].sort(byWeekDesc)[0];
const game = latest ? await getEntry("games", weekId(latest.season, latest.week)) : undefined;
const teamScore = game
  ? game.data.team.side === "home"
    ? game.data.home.score
    : game.data.away.score
  : null;
const oppScore = game
  ? game.data.team.side === "home"
    ? game.data.away.score
    : game.data.home.score
  : null;
const headline =
  latest && game
    ? `${resultWord(latest.result)} ${game.data.team.side === "home" ? "vs" : "at"} ${latest.opponent}, ${teamScore}-${oppScore}`
    : "";
---

<Base title={siteName}>
  <section class="py-12">
    <p class="text-sm font-semibold tracking-widest text-honolulu uppercase">
      {teamConfig.division}
    </p>
    <h1 class="mt-2 text-4xl font-extrabold tracking-tight sm:text-5xl">{siteName}</h1>
    <p class="mt-4 max-w-2xl text-lg">{teamConfig.tagline}</p>
    <p class="mt-6 max-w-2xl">
      Weekly game breakdowns, a clickable field heat map of every position group, and a transparent
      grading method built entirely from open data.
    </p>
  </section>

  {latest && game && (
    <section aria-labelledby="latest-heading" class="rounded-lg border border-silver/50 p-5">
      <h2 id="latest-heading" class="text-sm font-semibold tracking-widest uppercase">
        Latest game
      </h2>
      <p class="mt-2 text-2xl font-extrabold">{headline}</p>
      <p class="mt-1 flex flex-wrap items-center gap-2 text-sm text-ink/80 dark:text-silver/80">
        <span>
          {latest.season} week {latest.week}
        </span>
        <TierBadge tier={latest.tier} />
      </p>
      <p class="mt-3 text-sm">
        <a
          href={gameHref(latest.season, latest.week)}
          class="font-semibold text-honolulu underline underline-offset-2"
        >
          Read the breakdown
        </a>
      </p>
    </section>
  )}
</Base>
