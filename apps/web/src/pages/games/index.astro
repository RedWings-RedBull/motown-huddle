---
import { teamConfig } from "@huddle/shared";
import { getCollection, getEntry } from "astro:content";

import TierBadge from "../../components/TierBadge.astro";
import Base from "../../layouts/Base.astro";
import {
  byWeekDesc,
  formatKickoff,
  gameHref,
  resultWord,
  teamScores,
  venueWord,
  weekId,
} from "../../lib/week";

const manifest = await getEntry("manifest", "manifest");
const weeks = [...(manifest?.data.weeks ?? [])].sort(byWeekDesc);
const games = new Map((await getCollection("games")).map((g) => [g.id, g.data] as const));
const team = teamConfig.team;
---

<Base title="Games" description={`Every ${teamConfig.teamName} game breakdown with Den Grades.`}>
  <section class="bare">
    <p class="eyebrow">{teamConfig.teamName}</p>
    <h1 class="display mt-2 text-5xl text-white sm:text-6xl">Game breakdowns</h1>
    <p class="muted mt-3">
      One page per game: score, team metrics, win probability, the field heat map and key plays.
    </p>
  </section>
  {weeks.length === 0 ? (
    <p class="mt-6">No games yet. The first breakdown arrives with the next weekly data update.</p>
  ) : (
    <ol class="mt-6 grid gap-3">
      {weeks.map((w) => {
        const game = games.get(weekId(w.season, w.week));
        const venue = venueWord(game?.team.side ?? "away");
        const score = game ? teamScores(game) : undefined;
        const label = `${resultWord(w.result)} ${venue} ${w.opponent}${
          score ? `, ${score.teamScore}-${score.oppScore}` : ""
        }`;
        return (
          <li class="panel flex flex-wrap items-center gap-x-4 gap-y-1 px-5 py-4">
            <span class="eyebrow w-32">
              {w.season} · week {w.week}
            </span>
            <a
              href={gameHref(w.season, w.week)}
              class="display text-3xl text-white no-underline hover:text-honolulu-bright"
            >
              {label}
            </a>
            <span class="ml-auto flex items-center gap-2 text-sm">
              {game && (
                <time datetime={game.kickoffUtc} class="muted">
                  {formatKickoff(game.kickoffUtc)}
                </time>
              )}
              <TierBadge tier={w.tier} />
            </span>
          </li>
        );
      })}
    </ol>
  )}
  <p class="mt-6 text-sm">
    Grades for {team} are provisional on Tuesday and final once Pro-Football-Reference advanced
    stats land later in the week.
  </p>
</Base>
