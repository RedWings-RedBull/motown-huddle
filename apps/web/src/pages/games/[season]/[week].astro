---
import { teamConfig } from "@huddle/shared";
import { getCollection, getEntry } from "astro:content";

import FieldHeatMap from "../../../components/field/FieldHeatMap";
import KeyPlaysList from "../../../components/KeyPlaysList.astro";
import ScoreStrip from "../../../components/ScoreStrip.astro";
import TeamPanel from "../../../components/TeamPanel.astro";
import TierBadge from "../../../components/TierBadge.astro";
import WinProbChart from "../../../components/WinProbChart.astro";
import Base from "../../../layouts/Base.astro";
import { resultWord, weekSlug } from "../../../lib/week";

export async function getStaticPaths() {
  const games = await getCollection("games");
  return games.map((entry) => ({
    params: { season: String(entry.data.season), week: weekSlug(entry.data.week) },
    props: { id: entry.id },
  }));
}

interface Props {
  id: string;
}

const { id } = Astro.props;
const [game, teamMetrics, grades, keyPlays, winProbability, meta] = await Promise.all([
  getEntry("games", id),
  getEntry("teamMetrics", id),
  getEntry("grades", id),
  getEntry("keyPlays", id),
  getEntry("winProbability", id),
  getEntry("meta", id),
]);
const highlights = await getEntry("highlights", id);
if (!game || !teamMetrics || !grades || !keyPlays || !winProbability || !meta) {
  throw new Error(`Week ${id} is missing one of its data artifacts.`);
}

const team = teamConfig.team;
const opponent = game.data.team.opponent;
const teamScore = game.data.team.side === "home" ? game.data.home.score : game.data.away.score;
const oppScore = game.data.team.side === "home" ? game.data.away.score : game.data.home.score;
const title = `Week ${game.data.week}: ${team} ${teamScore}, ${opponent} ${oppScore}`;
const description = `${resultWord(game.data.team.result)} over ${opponent}, ${teamScore}-${oppScore}. Huddle Grades for every position slot, team metrics, win probability and key plays.`;
const sources = Object.entries(meta.data.sources).sort(([a], [b]) => a.localeCompare(b));
---

<Base
  title={title}
  description={description}
  preconnect={highlights ? ["https://i.ytimg.com"] : []}
>
  <nav aria-label="Breadcrumb" class="text-sm text-silver">
    <a href="/games/" class="underline hover:text-honolulu-bright">
      Games
    </a>
    <span aria-hidden="true"> / </span>
    <span>
      {game.data.season} week {game.data.week}
    </span>
  </nav>
  <p class="eyebrow mt-4">
    {game.data.season} season · week {game.data.week}
  </p>
  <h1 class="bare display mt-2 text-5xl text-white sm:text-7xl">
    <span class={game.data.team.result === "W" ? "text-honolulu-bright" : "text-silver"}>
      {resultWord(game.data.team.result)}
    </span>
    {` ${game.data.team.side === "home" ? "vs" : "at"} ${opponent}`}
  </h1>

  <div class="mt-6">
    <ScoreStrip game={game.data} />
  </div>

  <TeamPanel metrics={teamMetrics.data} opponent={opponent} />

  <section aria-labelledby="wp-heading" class="mt-8">
    <h2 id="wp-heading" class="section-title">
      Win probability
    </h2>
    <WinProbChart data={winProbability.data} team={team} opponent={opponent} />
  </section>

  <section aria-labelledby="field-heading" class="mt-8">
    <div class="flex flex-wrap items-center gap-3">
      <h2 id="field-heading" class="section-title">
        Field heat map
      </h2>
      <TierBadge tier={grades.data.tier} />
    </div>
    <p class="muted mt-2 max-w-3xl text-sm">
      Every slot shows the snap-weighted Huddle Grade of the players who lined up there. Pick a tile
      (click, tap, or Tab and Enter; arrow keys move between tiles) to see who played, how much, and
      every component behind the grade. Offensive linemen share one unit grade.{" "}
      <a href="/methodology/" class="underline hover:text-honolulu-bright">
        How the grade works
      </a>
      .
    </p>
    <div class="mt-4">
      <FieldHeatMap client:visible grades={grades.data} />
    </div>
  </section>

  <KeyPlaysList plays={keyPlays.data} team={team} highlights={highlights?.data} />

  <section aria-labelledby="sources-heading" class="muted mt-10 text-sm">
    <h2 id="sources-heading" class="eyebrow">
      Data build
    </h2>
    <p class="mt-1">
      Grade tier: <TierBadge tier={meta.data.tier} /> · pipeline {meta.data.pipelineVersion} ·
      grades {meta.data.gradesVersion}
    </p>
    <ul class="mt-2 grid gap-1 sm:grid-cols-2">
      {sources.map(([tag, stamp]) => (
        <li class="tabular-nums">
          <span class="font-mono">{tag}</span>: {stamp}
        </li>
      ))}
    </ul>
  </section>
</Base>
