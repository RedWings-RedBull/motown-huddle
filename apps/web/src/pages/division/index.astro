---
import { teamConfig, teamName } from "@huddle/shared";
import { getEntry } from "astro:content";

import Base from "../../layouts/Base.astro";
import { formatPct, formatSigned, ordinal } from "../../lib/format";
import { formatKickoff } from "../../lib/week";

const entry = await getEntry("division", "current");
if (!entry)
  throw new Error("Division data is missing; run `pnpm pipeline --division --season <year>`.");
const d = entry.data;
const team = teamConfig.team;
const rec = (r: { w: number; l: number; t: number }) =>
  r.t ? `${r.w}-${r.l}-${r.t}` : `${r.w}-${r.l}`;
const share = (x: number) => `${Math.round(x * 100)}%`;
const notes = d.standings.filter((s) => s.resolvedBy !== null);
const oddsByTeam = new Map(d.odds.map((o) => [o.team, o]));
const profileByTeam = new Map(d.profiles.map((p) => [p.team, p]));
const maxWins = Math.max(...d.odds.map((o) => o.winDistribution.length - 1), 1);
const rowClass = (t: string) => (t === team ? "bg-honolulu/15" : "");
---

<Base
  title={d.division}
  description={`${d.division} standings with NFL tiebreakers, division and playoff odds from a seeded simulation, and season-to-date efficiency for all four clubs.`}
>
  <section class="bare">
    <p class="eyebrow">
      {d.conference} · through week {d.throughWeek}
    </p>
    <h1 class="display mt-2 text-5xl text-white sm:text-7xl">{d.division}</h1>
    <p class="muted mt-2 text-sm">
      Standings, odds and efficiency for the four clubs; the {teamConfig.teamName} row is
      highlighted.
    </p>
  </section>

  <section aria-labelledby="standings-heading" class="mt-8">
    <h2 id="standings-heading" class="section-title">
      Standings
    </h2>
    <div class="mt-4">
      <table class="w-full text-sm" data-standings>
        <thead>
          <tr class="eyebrow text-left">
            <th scope="col" class="py-2 pr-3">
              #
            </th>
            <th scope="col" class="py-2 pr-3">
              Team
            </th>
            <th scope="col" class="py-2 pr-3 text-right">
              W-L
            </th>
            <th scope="col" class="py-2 pr-3 text-right">
              Pct
            </th>
            <th scope="col" class="hidden py-2 pr-3 text-right sm:table-cell">
              Div
            </th>
            <th scope="col" class="hidden py-2 pr-3 text-right sm:table-cell">
              Conf
            </th>
            <th scope="col" class="hidden py-2 pr-3 text-right sm:table-cell">
              PF
            </th>
            <th scope="col" class="hidden py-2 pr-3 text-right sm:table-cell">
              PA
            </th>
            <th scope="col" class="py-2 pr-3 text-right">
              Diff
            </th>
            <th scope="col" class="hidden py-2 pr-3 sm:table-cell">
              Streak
            </th>
            <th scope="col" class="py-2">
              Last 5
            </th>
          </tr>
        </thead>
        <tbody>
          {d.standings.map((s) => (
            <tr class:list={["border-t border-white/10", rowClass(s.team)]} data-team={s.team}>
              <td class="py-2 pr-3 tabular-nums">{s.rank}</td>
              <th scope="row" class="py-2 pr-3 text-left font-semibold text-white">
                <span class="sm:hidden">{s.team}</span>
                <span class="hidden sm:inline">{teamName(s.team)}</span>
                {s.resolvedBy && (
                  <sup class="muted ml-1 text-xs" aria-label={`Tiebreaker: ${s.resolvedBy}`}>
                    {notes.indexOf(s) + 1}
                  </sup>
                )}
              </th>
              <td class="py-2 pr-3 text-right tabular-nums">{rec(s)}</td>
              <td class="py-2 pr-3 text-right tabular-nums">{s.pct.toFixed(3)}</td>
              <td class="hidden py-2 pr-3 text-right tabular-nums sm:table-cell">
                {rec(s.division)}
              </td>
              <td class="hidden py-2 pr-3 text-right tabular-nums sm:table-cell">
                {rec(s.conference)}
              </td>
              <td class="hidden py-2 pr-3 text-right tabular-nums sm:table-cell">{s.pointsFor}</td>
              <td class="hidden py-2 pr-3 text-right tabular-nums sm:table-cell">
                {s.pointsAgainst}
              </td>
              <td class="py-2 pr-3 text-right tabular-nums">
                {formatSigned(s.pointsFor - s.pointsAgainst, 0)}
              </td>
              <td class="hidden py-2 pr-3 tabular-nums sm:table-cell">{s.streak || "—"}</td>
              <td class="py-2">
                <span
                  class="flex gap-1"
                  aria-label={`Last five: ${s.lastFive.join(", ") || "none"}`}
                >
                  {s.lastFive.map((r) => (
                    <span
                      class:list={[
                        "inline-block h-4 w-4 rounded-sm text-center text-[10px] leading-4 font-bold",
                        r === "W"
                          ? "bg-honolulu-bright text-ink"
                          : r === "L"
                            ? "bg-white/15 text-white"
                            : "bg-silver text-ink",
                      ]}
                    >
                      {r}
                    </span>
                  ))}
                </span>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    {notes.length > 0 && (
      <ol class="muted mt-3 list-decimal pl-5 text-xs">
        {notes.map((s) => (
          <li>
            {teamName(s.team)} placed by {s.resolvedBy}.
          </li>
        ))}
      </ol>
    )}
  </section>

  <section aria-labelledby="odds-heading" class="mt-8">
    <h2 id="odds-heading" class="section-title">
      Division and playoff odds
    </h2>
    <p class="muted mt-2 text-sm">
      {d.simulation.runs.toLocaleString()} simulated seasons of the {d.simulation.gamesRemaining}{" "}
      remaining games. Published spreads decide the next week's games; the rest use a
      point-differential rating with a two-point home edge. Wild-card tiebreakers are simplified.
    </p>
    <ul class="mt-4 grid gap-3 sm:grid-cols-2">
      {d.standings.map((s) => {
        const o = oddsByTeam.get(s.team);
        if (!o) return null;
        return (
          <li
            class:list={["rounded-xl border border-white/10 bg-white/5 p-4", rowClass(s.team)]}
            data-odds={s.team}
          >
            <p class="font-display text-2xl text-white">{teamName(s.team)}</p>
            <dl class="mt-2 grid grid-cols-3 gap-2 text-sm">
              <div>
                <dt class="eyebrow">Division</dt>
                <dd class="display text-3xl text-white">{share(o.division)}</dd>
              </div>
              <div>
                <dt class="eyebrow">Playoffs</dt>
                <dd class="display text-3xl text-white">{share(o.playoffs)}</dd>
              </div>
              <div>
                <dt class="eyebrow">Exp. wins</dt>
                <dd class="display text-3xl text-white">{o.expectedWins.toFixed(1)}</dd>
              </div>
            </dl>
            <svg
              viewBox={`0 0 ${maxWins + 1} 10`}
              class="mt-3 h-8 w-full"
              preserveAspectRatio="none"
              role="img"
              aria-label={`Win distribution for ${teamName(s.team)}: most likely ${o.winDistribution.indexOf(Math.max(...o.winDistribution))} wins`}
            >
              {o.winDistribution.map((p, wins) => (
                <rect
                  x={wins + 0.1}
                  y={10 - p * 30}
                  width={0.8}
                  height={p * 30}
                  class={
                    wins === o.winDistribution.indexOf(Math.max(...o.winDistribution))
                      ? "fill-honolulu-bright"
                      : "fill-white/30"
                  }
                />
              ))}
            </svg>
            <p class="muted mt-1 text-xs">Regular-season win distribution, 0 to {maxWins}.</p>
          </li>
        );
      })}
    </ul>
  </section>

  <section aria-labelledby="eff-heading" class="mt-8">
    <h2 id="eff-heading" class="section-title">
      Efficiency
    </h2>
    <p class="muted mt-2 text-sm">
      Expected points added per play with league ranks through week {d.throughWeek}. Defense is what
      the unit allows (1 = stingiest).
    </p>
    <div class="mt-4">
      <table class="w-full text-sm">
        <thead>
          <tr class="eyebrow text-left">
            <th scope="col" class="py-2 pr-3">
              Team
            </th>
            <th scope="col" class="py-2 pr-3 text-right">
              Off EPA / play
            </th>
            <th scope="col" class="hidden py-2 pr-3 text-right sm:table-cell">
              Off success
            </th>
            <th scope="col" class="py-2 pr-3 text-right">
              Def EPA / play
            </th>
            <th scope="col" class="hidden py-2 text-right sm:table-cell">
              Def success
            </th>
          </tr>
        </thead>
        <tbody>
          {d.standings.map((s) => {
            const p = profileByTeam.get(s.team);
            if (!p) return null;
            const cell = (value: string, rank: number, phone = true) => (
              <td
                class:list={[
                  "py-2 pr-3 text-right tabular-nums",
                  phone ? "" : "hidden sm:table-cell",
                ]}
              >
                <span class="font-semibold text-white">{value}</span>
                <span class="muted ml-1 text-xs">{ordinal(rank)}</span>
              </td>
            );
            return (
              <tr class:list={["border-t border-white/10", rowClass(s.team)]}>
                <th scope="row" class="py-2 pr-3 text-left font-semibold text-white">
                  <span class="sm:hidden">{s.team}</span>
                  <span class="hidden sm:inline">{teamName(s.team)}</span>
                </th>
                {cell(formatSigned(p.offense.epaPerPlay.value, 2), p.offense.epaPerPlay.leagueRank)}
                {cell(
                  formatPct(p.offense.successRate.value),
                  p.offense.successRate.leagueRank,
                  false,
                )}
                {cell(formatSigned(p.defense.epaPerPlay.value, 2), p.defense.epaPerPlay.leagueRank)}
                {cell(
                  formatPct(p.defense.successRate.value),
                  p.defense.successRate.leagueRank,
                  false,
                )}
              </tr>
            );
          })}
        </tbody>
      </table>
    </div>
  </section>

  <section aria-labelledby="up-heading" class="mt-8">
    <h2 id="up-heading" class="section-title">
      This week in the {d.division}
    </h2>
    {d.upcoming.length === 0 ? (
      <p class="muted mt-2 text-sm">No games scheduled.</p>
    ) : (
      <ul class="mt-4 divide-y divide-white/10">
        {d.upcoming.map((u) => (
          <li class="flex flex-wrap items-baseline gap-x-3 py-2 text-sm">
            <time datetime={u.kickoffUtc} class="muted w-56">
              {formatKickoff(u.kickoffUtc)}
            </time>
            <span class="font-display text-lg text-white">
              {u.away} at {u.home}
            </span>
            {u.divGame && (
              <span class="badge border-honolulu/60 bg-honolulu/20 text-honolulu-bright">
                division game
              </span>
            )}
            {u.spread !== null && (
              <span class="muted ml-auto tabular-nums">
                {u.spread > 0
                  ? `${u.home} -${u.spread}`
                  : u.spread < 0
                    ? `${u.away} ${u.spread}`
                    : "pick"}
              </span>
            )}
          </li>
        ))}
      </ul>
    )}
  </section>

  <section class="mt-8 text-sm">
    <h2 class="section-title">How this is computed</h2>
    <p class="muted mt-2">
      Standings apply the NFL division tiebreaking steps in order: head-to-head, division record,
      common games, conference record, strength of victory, strength of schedule, conference and
      league points rankings, net points in common games, net points overall. Net touchdowns (step
      11) are not available in the schedule data, and the coin toss is replaced by alphabetical
      order; both are labelled when used. Odds come from a seeded Monte Carlo (seed{" "}
      {d.simulation.seed}), so the page rebuilds identically from the same inputs.
    </p>
  </section>
</Base>
