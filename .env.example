# Copy to .env (git-ignored). Every value is optional for local development; the AWS block is
# needed only at the Launch milestone.

# Personal AWS account id (12 digits). The CDK app refuses to synthesize without it.
HUDDLE_AWS_ACCOUNT_ID=
# GitHub repo the OIDC deploy role trusts (owner/name)
HUDDLE_GITHUB_REPO=RedWings-RedBull/motown-huddle
# Optional: email for the $1/month AWS budget alarm
HUDDLE_BUDGET_EMAIL=
# Optional: custom domain (apex, e.g. example.com) and its Route 53 public hosted zone id. Set both
# or neither; without them the site is served on the CloudFront URL. www redirects to the apex.
HUDDLE_DOMAIN_NAME=
HUDDLE_HOSTED_ZONE_ID=
# Optional: ARN of an existing token.actions.githubusercontent.com identity provider in the account
# (IAM -> Identity providers). An account can hold only one, so reuse it if another project made it.
HUDDLE_GITHUB_OIDC_PROVIDER_ARN=

# Web (Astro reads PUBLIC_* at build time)
PUBLIC_SITE_URL=http://localhost:4321
PUBLIC_SITE_NAME=Motown Huddle

# Optional: YouTube Data API v3 key (free; a Google Cloud project with no billing). Lets
# `pnpm pipeline --highlights` find each game's official highlights video.
HUDDLE_YOUTUBE_API_KEY=

# Optional: lets `pnpm writer` draft articles with Claude Code on your Pro/Max subscription.
# Create it with `pnpm --filter @huddle/writer exec claude setup-token`. Same value as the
# CLAUDE_CODE_OAUTH_TOKEN repository secret.
CLAUDE_CODE_OAUTH_TOKEN=
# Optional overrides for the article writer (defaults: sonnet, high).
HUDDLE_WRITER_MODEL=
HUDDLE_WRITER_EFFORT=
